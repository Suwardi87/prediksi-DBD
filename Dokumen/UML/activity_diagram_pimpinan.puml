@startuml activity_diagram_pimpinan
!theme plain
skinparam backgroundColor #FEFEFE
skinparam activityFontSize 11

title Activity Diagram Pimpinan (DEPRECATED)\nSistem Prediksi Penyebaran DBD

note right
  Role "Pimpinan" tidak ada dalam kode.
  Fitur yang sebelumnya milik pimpinan
  (Kelola Wilayah, Laporan Per Wilayah)
  sudah tidak tersedia.
  Diagram ini hanya untuk referensi historis.
end note

start

:Membuka Halaman Login;

:Memasukkan Username dan Password;

if (Validasi Login?) then (Valid)
    :Masuk ke Dashboard;
    
    repeat
        :Pilih Menu;
        
        switch (Menu yang dipilih?)
        case (Dashboard)
            :Tampilkan Total Kasus;
            :Tampilkan Grafik Trend;
            :Tampilkan Distribusi Risiko;
            :Tampilkan Status Model;
            
        case (Lihat Laporan)
            :Pilih Filter Periode;
            :Tampilkan Laporan;
            :Cetak/Export Laporan;
            
        endswitch
        
    repeat while (Lanjut?) is (Ya)

    :Logout;
    
else (Tidak Valid)
    :Tampilkan Pesan Error;
    :Kembali ke Form Login;
endif

stop

@enduml
