@startuml use_case_diagram
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam usecaseFontSize 11
skinparam actorFontSize 12
skinparam packageFontSize 14
skinparam packageFontStyle bold
skinparam rectangleBorderColor #0066CC
skinparam rectangleBackgroundColor #E6F5FF
skinparam shadowing false
skinparam roundcorner 0

title **Use Case Diagram**\nSistem Prediksi Penyebaran DBD - RSUD Lubuk Basung

left to right direction

actor "Administrator" as Admin #CCE5FF
actor "Petugas" as Petugas #CCFFCC

rectangle "Sistem Prediksi Penyebaran DBD" as system #E6F5FF {
  usecase "Login" as UC1 #FFE6CC
  usecase "Logout" as UC2 #FFE6CC
  usecase "Kelola\nPengguna" as UC3 #FFE6E6
  usecase "Kelola Data\nPasien" as UC4 #FFE6E6
  usecase "Perhitungan\nManual" as UC6 #FFF4E6
  usecase "Data Uji" as UC13 #FFF4E6
  usecase "Training Model\nRandom Forest" as UC7 #FFF4E6
  usecase "Prediksi\nRisiko DBD" as UC8 #E6F5FF
  usecase "Evaluasi\nModel" as UC9 #E6F5FF
  usecase "Dashboard" as UC10 #E6FFE6
  usecase "Laporan" as UC11 #E6FFE6
  usecase "Log Aktivitas" as UC12 #FFE6E6
}

Admin --> UC1
Admin --> UC2
Admin --> UC10
Admin --> UC11
Admin --> UC4
Admin --> UC3
Admin --> UC12
Admin --> UC6
Admin --> UC13
Admin --> UC7
Admin --> UC8
Admin --> UC9

Petugas --> UC1
Petugas --> UC2
Petugas --> UC10
Petugas --> UC11
Petugas --> UC7
Petugas --> UC8
Petugas --> UC9
Petugas --> UC6
Petugas --> UC13

legend right
  |= Warna |= Keterangan |
  | <#FFE6E6> | Admin Only |
  | <#FFF4E6> | Admin+Petugas |
  | <#E6F5FF> | All Roles |
  | <#FFE6CC> | Authentication |
endlegend

@enduml
