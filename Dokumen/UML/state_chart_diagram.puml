@startuml state_chart_diagram
skinparam state {
  BackgroundColor<<admin>> #FFE6E6
  BorderColor<<admin>> #CC0000
  BackgroundColor<<both>> #FFF4E6
  BorderColor<<both>> #FF9900
  BackgroundColor<<all>> #E6F5FF
  BorderColor<<all>> #3399FF
  BackgroundColor<<auth>> #FFE6CC
  BorderColor<<auth>> #FF9933
}
skinparam stateAttributeFontSize 10
skinparam fontSize 12

title State Chart Diagram\nSistem Prediksi Penyebaran DBD

[*] --> HalamanLogin

state "Halaman Login" as HalamanLogin <<auth>> {
  HalamanLogin : entry / render form login
  HalamanLogin : do / menunggu input pengguna
}

state "Memvalidasi Kredensial" as Validasi <<auth>> {
  Validasi : entry / kirim data ke server
  Validasi : do / query user di database
}

state "Login Gagal" as LoginGagal <<admin>> {
  LoginGagal : entry / tampilkan pesan error
}

state "Session Aktif" as SessionAktif <<all>> {
  SessionAktif : entry / login_user()
  SessionAktif : do / update last_login
}

state "Dashboard" as Dashboard <<all>> {
  Dashboard : entry / redirect('/dashboard')
  Dashboard : do / tampilkan ringkasan data
}

HalamanLogin --> Validasi : klik Login
Validasi --> LoginGagal : [invalid]
LoginGagal --> HalamanLogin : input ulang
Validasi --> SessionAktif : [valid]
SessionAktif --> Dashboard : session aktif

state "Pilih Menu" as PilihMenu <<all>>
Dashboard --> PilihMenu

state "Kelola Data Pasien" as KelolaPasien <<both>> {
  KelolaPasien : entry / query pasien_dbd
  KelolaPasien : do / CRUD data pasien
}

state "Import Data Excel" as ImportExcel <<both>> {
  ImportExcel : entry / form upload
  ImportExcel : do / pd.read_excel()
}

state "Training Model RF" as TrainingModel <<both>> {
  TrainingModel : entry / load data
  TrainingModel : do / train RandomForest
}

state "Prediksi Risiko DBD" as PrediksiRisiko <<all>> {
  PrediksiRisiko : entry / load model RF
  PrediksiRisiko : do / predict & predict_proba
}

state "Lihat Laporan" as LihatLaporan <<all>> {
  LihatLaporan : entry / query statistik
  LihatLaporan : do / tampilkan grafik & tabel
}

state "Kelola Pengguna" as KelolaPengguna <<admin>> {
  KelolaPengguna : entry / query users
  KelolaPengguna : do / CRUD pengguna
}

state "Kelola Wilayah" as KelolaWilayah <<admin>> {
  KelolaWilayah : entry / query wilayah
  KelolaWilayah : do / CRUD wilayah
}

state "Log Aktivitas" as LogAktivitas <<admin>> {
  LogAktivitas : entry / query log_aktivitas
  LogAktivitas : do / tampilkan log
}

PilihMenu --> KelolaPasien : Data Pasien
PilihMenu --> ImportExcel : Import
PilihMenu --> TrainingModel : Training
PilihMenu --> PrediksiRisiko : Prediksi
PilihMenu --> LihatLaporan : Laporan
PilihMenu --> KelolaPengguna : [admin only]
PilihMenu --> KelolaWilayah : [admin only]
PilihMenu --> LogAktivitas : [admin only]

state "Lanjut?" as Lanjut <<all>>
KelolaPasien --> Lanjut
ImportExcel --> Lanjut
TrainingModel --> Lanjut
PrediksiRisiko --> Lanjut
LihatLaporan --> Lanjut
KelolaPengguna --> Lanjut
KelolaWilayah --> Lanjut
LogAktivitas --> Lanjut

state "Logout" as Logout <<auth>> {
  Logout : entry / clear session
  Logout : do / redirect ke login
}

Lanjut --> PilihMenu : Ya
Lanjut --> Logout : Tidak
Logout --> [*]

legend right
  |= Color |= Access |
  |<#FFE6E6>| Admin Only |
  |<#FFF4E6>| Admin + Petugas |
  |<#E6F5FF>| All Roles |
  |<#FFE6CC>| Authentication |
endlegend

@enduml
