@startuml deployment_diagram
skinparam backgroundColor #FEFEFE
skinparam nodeFontSize 11
skinparam componentFontSize 10
skinparam artifactFontSize 9

title Deployment Diagram
title Sistem Prediksi Penyebaran DBD - RSUD Lubuk Basung

node "Client Workstation" <<device>> {
    node "Web Browser" <<execution environment>> {
        artifact "HTML/CSS/JS"
        artifact "Jinja2 Templates"
    }
}

node "Application Server" <<device>> {
    node "XAMPP (Apache)" <<execution environment>>
    node "Flask Application (Python 3.11)" <<execution environment>> {
        component "Flask Routes" <<component>>
        component "SQLAlchemy Models" <<component>>
        component "ML Model (RF)" <<component>>
    }
    artifact "model_rf.pkl" <<artifact>>
    artifact "config.py" <<artifact>>
    artifact "requirements.txt" <<artifact>>
}

node "Database Server" <<device>> {
    node "MySQL Server 8.0 (MariaDB)" <<execution environment>> {
        component "Database Engine" <<component>>
    }
    artifact "dbd_prediction\ndatabase schema" <<artifact>>
    note right
      Tables:
      - users
      - pasien_dbd
      - kasus_bulanan
      - hasil_prediksi
      - log_aktivitas
    end note
}

node "File Storage" <<device>> {
    node "File System (Windows/Linux)" <<execution environment>> {
        artifact "uploads/"
        artifact "models/"
        artifact "reports/"
        artifact "logs/"
    }
}

Client -right- App : <<HTTP/HTTPS>>\nTCP/IP
App -right- DB : <<JDBC/MySQL>>\nPort 3306
App -down- File : <<File I/O>>

note bottom of Client
  Network Infrastructure
  - Protocol: HTTP/HTTPS (Port 80/443)
  - Network: Local Area Network (LAN)
  - Topology: Client-Server Architecture
  - Security: SSL/TLS Encryption, Firewall Protection
  - Backup: Daily database backup, Model versioning
end note

note bottom of App
  Deployment Specifications:
  - OS: Windows 10/11 or Linux Ubuntu 20.04+
  - Python: 3.11.x
  - Database: MySQL 8.0 / MariaDB 10.6+
  - Web Server: Apache 2.4 (via XAMPP)
  - Memory: Minimum 4GB RAM
  - Storage: Minimum 10GB available
end note

note left of Client
  Deployment diagram menunjukkan
  arsitektur fisik sistem dengan:
  - Device nodes (workstation, servers)
  - Execution environments (runtime)
  - Components dan artifacts
  - Communication protocols
end note

legend right
  |= Stereotype |= Keterangan |
  | <#E6F5FF> | <<device>> Hardware Node |
  | <#FFFFFF> | <<component>> Software Component |
  | <color:#3399FF>-------</color> | Communication Path |
endlegend

@enduml
