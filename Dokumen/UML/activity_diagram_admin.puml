@startuml activity_diagram_admin
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam activityFontSize 11

title Activity Diagram - Administrator\nSistem Prediksi Penyebaran DBD

start

:Membuka Halaman Login;

:Memasukkan Username dan Password;

if (Valid?) then (Ya)
    :Tampilkan Dashboard;
    
    repeat
    
    :Pilih Menu;
    
    :Kelola Data Pasien;
    
    :Kelola Pengguna;
    
    :Log Aktivitas;
    
    :Training Model;
    
    :Prediksi Risiko;
    
    :Lihat Laporan;
    
    repeat while (Lanjut?) is (Ya)
    
    :Logout;
    
else (Tidak)
    :Tampilkan Pesan Error;
    :Kembali ke Form Login;
endif

stop

legend right
  |= Warna |= Keterangan |
  | **Merah** | Admin Only |
  | **Oranye** | Admin + Petugas |
  | **Biru** | Semua Role |
endlegend

@enduml
