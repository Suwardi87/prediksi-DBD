@startuml activity_diagram_admin
skinparam backgroundColor #FEFEFE
skinparam activityFontSize 11

title Activity Diagram - Administrator\nSistem Prediksi Penyebaran DBD

start

:Membuka Halaman Login;

:Memasukkan Username dan Password;

if (Valid?) then (Ya)
    :Tampilkan Dashboard;
    
    repeat
    
    :Pilih Menu;
    
    :Kelola Data Pasien;
    
    :Kelola Pengguna;
    
    :Log Aktivitas;
    
    :Training Model;
    
    :Prediksi Risiko;
    
    :Lihat Laporan;
    
    repeat while (Lanjut?) is (Ya)
    
    :Logout;
    
else (Tidak)
    :Tampilkan Pesan Error;
    :Kembali ke Form Login;
endif

stop

note right of :Kelola Data Pasien
  Admin Only
end note

note right of :Kelola Pengguna
  Admin Only
end note

note right of :Log Aktivitas
  Admin Only
end note

note right of :Training Model
  Admin + Petugas
end note

note right of :Prediksi Risiko
  Semua Role
end note

note right of :Lihat Laporan
  Semua Role
end note

@enduml
