@startuml Sequence Diagram - Training
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam sequenceMessageAlign center

title Sequence Diagram - Training Model RF\nSistem Prediksi Penyebaran DBD

actor "Admin/\nPetugas" as admin
participant Browser
participant "Flask App\n(training.py)" as flask
database "Database\n(MySQL)" as db
participant "ML Model\n(ml_model.py)" as ml
participant "RF Algorithm\n(Manual)" as rf

== Training Model RF ==

admin -> Browser : 1: Klik menu Training
Browser -> flask : 2: GET /training/
flask -> db : 3: SELECT * FROM pasien_dbd
db --> flask : 4: return dataset (n records)
flask --> Browser : 5: Tampilkan info dataset
Browser --> admin : 6: Tampilkan halaman training

admin -> Browser : 7: Klik tombol 'Mulai Training'
Browser -> flask : 8: POST /training/train
flask -> ml : 9: train_model()
note left of ml : Note: Training menggunakan 3 fitur\n(Usia, Lama Rawat, Jenis Kelamin),\nmax_features=None, 5-fold CV
note left of ml : Note: n_estimators bisa\ndikonfigurasi pengguna
note left of ml : Note: Metrics (accuracy, precision,\nrecall, f1, cv_score) disimpan\ke database
ml -> ml : 10: prepare_dataset()

loop [25 trees]
    ml -> rf : 11: build_tree()
    rf -> rf : 12: calculate_entropy()
    rf --> ml : 13: return decision_tree
end

ml -> ml : 14: evaluate_model()
ml --> flask : 15: return metrics (MAE, RMSE, R²)
flask -> db : 16: save(ModelEvaluasi)
db --> flask : 17: return success

@enduml
