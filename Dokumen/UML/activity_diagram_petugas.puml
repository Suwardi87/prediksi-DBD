@startuml activity_diagram_petugas
!theme plain
skinparam backgroundColor #FEFEFE
skinparam activityFontSize 11

title Activity Diagram Petugas\nSistem Prediksi Penyebaran DBD

start

:Membuka Halaman Login;

:Memasukkan Username dan Password;

if (Validasi Login?) then (Valid)
    :Masuk ke Dashboard;
    
    repeat
        :Pilih Menu;
        
        switch (Menu yang dipilih?)
        case (Dashboard)
            :Tampilkan Total Kasus;
            :Tampilkan Grafik Trend;
            :Tampilkan Distribusi Risiko;
            :Tampilkan Status Model;
            
        case (Kelola Data Pasien)
            :Tampilkan Daftar Pasien;
            if (Aksi?) then (Tambah)
                :Input Data Pasien Baru;
                :Validasi Data;
                :Simpan ke Database;
            elseif (Edit) then
                :Pilih Data Pasien;
                :Edit Data;
                :Update Database;
            else (Hapus)
                :Konfirmasi Hapus;
                :Hapus dari Database;
            endif
            
        case (Import Data Excel)
            :Pilih File Excel;
            :Upload File;
            :Validasi Format;
            if (Format Valid?) then (Ya)
                :Proses Import Data;
                :Tampilkan Hasil Import;
            else (Tidak)
                :Tampilkan Error;
            endif
            
        case (Data Uji)
            :Pilih Dataset Uji;
            :Atur Parameter Uji;
            :Jalankan Uji Model;
            :Tampilkan Hasil Uji;
            
        case (Training Model)
            :Atur Parameter;
            :n_estimators, max_depth, test_size;
            :Mulai Training;
            :Tunggu Proses;
            :Tampilkan Metrik Evaluasi;
            
        case (Perhitungan Manual)
            :Input Data Manual;
            :Pilih Metode Perhitungan;
            :Jalankan Perhitungan;
            :Tampilkan Hasil Perhitungan;
            
        case (Evaluasi Model)
            :Tampilkan Metrik Evaluasi;
            :Accuracy, Precision, Recall;
            :Tampilkan Confusion Matrix;
            :Tampilkan Feature Importance;
            
        case (Laporan)
            :Pilih Filter Periode;
            :Pilih Jenis Laporan;
            :Tampilkan Laporan;
            :Cetak/Export Laporan;
            
        endswitch
        
    repeat while (Lanjut?) is (Ya)

    :Logout;
    
else (Tidak Valid)
    :Tampilkan Pesan Error;
    :Kembali ke Form Login;
endif

stop

@enduml
