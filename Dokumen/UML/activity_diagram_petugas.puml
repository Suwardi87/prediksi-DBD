@startuml activity_diagram_petugas
skinparam backgroundColor #FEFEFE
skinparam activityFontSize 11

title Activity Diagram - Petugas\nSistem Prediksi Penyebaran DBD

start

:Membuka Halaman Login;

:Memasukkan Username dan Password;

if (Valid?) then (Ya)
    :Akses Dashboard;
    
    repeat
    
    :Pilih Menu;
    
    :Training Model;
    
    :Prediksi Risiko;
    
    :Evaluasi Model;
    
    :Lihat Laporan;
    
    repeat while (Lanjut?) is (Ya)
    
    :Logout;
    
else (Tidak)
endif

stop

note left of :Training Model
  Admin + Petugas
end note

note left of :Prediksi Risiko
  Semua Role
end note

note left of :Evaluasi Model
  Admin + Petugas
end note

note left of :Lihat Laporan
  Semua Role
end note

note
  Note: Petugas tidak bisa akses
  Data Pasien, Kelola Pengguna,
  dan Log Aktivitas
end note

@enduml
