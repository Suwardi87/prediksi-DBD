@startuml activity_diagram_petugas
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam activityFontSize 11

title Activity Diagram - Petugas\nSistem Prediksi Penyebaran DBD

start

:Membuka Halaman Login;

:Memasukkan Username dan Password;

if (Valid?) then (Ya)
    :Akses Dashboard;
    
    repeat
    
    :Pilih Menu;
    
    :Training Model;
    
    :Prediksi Risiko;
    
    :Evaluasi Model;
    
    :Lihat Laporan;
    
    repeat while (Lanjut?) is (Ya)
    
    :Logout;
    
else (Tidak)
endif

stop

legend right
  **Note:** Petugas tidak bisa akses
  Data Pasien, Kelola Pengguna,
  dan Log Aktivitas.
  ||
  |= Warna |= Keterangan |
  | **Oranye** | Admin + Petugas |
  | **Biru** | Semua Role |
endlegend

@enduml
