        <mxCell id="c_User" value="&lt;b&gt;User&lt;/b&gt;&lt;hr/&gt;- id: Integer (PK)&lt;br/&gt;- username: String(50) UNIQUE&lt;br/&gt;- password: String(255)&lt;br/&gt;- nama_lengkap: String(100)&lt;br/&gt;- email: String(100)&lt;br/&gt;- role: Enum(admin,petugas,pimpinan)&lt;br/&gt;- foto: String(255)&lt;br/&gt;- status: Enum(aktif,nonaktif)&lt;br/&gt;- last_login: DateTime&lt;br/&gt;- created_at: DateTime&lt;br/&gt;- updated_at: DateTime&lt;hr/&gt;+ check_password(password): Boolean&lt;br/&gt;+ login(): Boolean&lt;br/&gt;+ logout(): Void&lt;br/&gt;+ create(): Boolean&lt;br/&gt;+ update(): Boolean&lt;br/&gt;+ delete(): Boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#FFFACD;strokeColor=#8B8000;fontSize=9;" vertex="1" parent="1">
